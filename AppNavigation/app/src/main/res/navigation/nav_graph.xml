<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.ismailcanvarli.appnavigation.DashboardFragment"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_profileFragment"
            app:destination="@id/navigation" />
        <action
            android:id="@+id/action_dashboardFragment_to_settingsDialogFragment"
            app:destination="@id/settingsDialogFragment" />

        <deepLink app:uri="https://www.example.com/profile/{userId}" />
        <action
            android:id="@+id/action_dashboardFragment_to_secondActivity"
            app:destination="@id/secondActivity" />

        <action
            android:id="@+id/action_dashboardFragment_to_nav_graph_payment"
            app:destination="@id/nav_graph_payment" />

        <activity
            android:id="@+id/secondActivity"
            android:name="com.ismailcanvarli.appnavigation.SecondActivity"
            android:label="activity_second_activity"
            tools:layout="@layout/activity_second_activity" />
    </fragment>

    <include
        android:id="@+id/nav_graph_payment"
        app:graph="@navigation/nav_graph_payment" />

    <dialog
        android:id="@+id/settingsDialogFragment"
        android:name="com.ismailcanvarli.appnavigation.SettingsDialogFragment"
        android:label="fragment_settings_dialog"
        tools:layout="@layout/fragment_settings_dialog" />

</navigation>